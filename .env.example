# Nothing is required for phase 1. Worm only reads the chain.
WH_RPC=https://rpc.mainnet.chain.robinhood.com
WH_PORT=4670
WH_BACKFILL_HOURS=72      # launches kept for creator history
WH_SCORE_HOURS=0          # graduations scored at startup; 0 (the default): only new ones from now on, no catching up
# The character grows with the treasury it holds. Leave empty until the wallets exist.
WH_WALLET=                # Robinhood Chain address (ETH + USDG)
WH_BASE_WALLET=           # Base address (USDC for the Venice fallback only)
# WH_RESCAN_TOKEN=        # lets a remote caller use /api/rescan (header X-Rescan-Token). Unset: loopback only.
WH_REPO_URL=https://github.com/wormrobinhood/worm   # public source, linked from /docs
# The token's on-chain metadata is written once at launch and cannot change: set these first.
# WH_SITE_URL=https://example.com      # the final domain: the logo and website links point here
# WH_TOKEN_X=                           # X handle or https://x.com/profile; saved on-chain as an absolute URL
# WH_TOKEN_TELEGRAM=                    # Telegram handle or https://t.me/group; saved on-chain as an absolute URL
# WH_TOKEN_WEBSITE=                     # defaults to WH_SITE_URL
# WH_TOKEN_LOGO=                        # defaults to WH_SITE_URL/logo.png
# WH_CREATOR_TAX_BPS=200                # 2% creator tax, paid entirely to the worm
# Optional initial purchase; independent of WH_TRADING. Default off. Set only after reviewing the quote.
# WH_LAUNCH_BUY=0                      # 1: atomic launch + at least 2% of supply, then transfer 1% to WH_OWNER_WALLET
# WH_LAUNCH_BUY_MAX_USDG=               # required explicit purchase cap in USDG; no automatic cap increase
# WH_LAUNCH_KEEP_USDG=                  # required positive USDG reserve left after purchase, separate from owed fees
# WH_LAUNCH_KEEP_ETH=                   # required positive ETH reserve left after each launch/allocation transaction
# Once started, turning WH_LAUNCH_BUY off does not cancel the saved intent. Use WH_LIVE=0 or payments.paused to stop sends.
# Compute: who sells the worm its inference and how it pays. AI Surplus is paid with plain USDG transfers on
# Robinhood Chain to the account's deposit address, so nothing is bridged; its open models are free during the pilot.
# WH_COMPUTE_PROVIDER=aisurplus                 # or venice (USDC on Base through x402)
# WH_AISURPLUS_KEY=                             # secret: minted at aisurplus.io/app/keys with a weekly cap. Never commit it.
# WH_AISURPLUS_DEPOSIT=                         # the Robinhood Chain deposit address aisurplus.io/app/wallet shows
# WH_VOICE_EVERY_MIN=60                      # minimum minutes between approved field notes
# WH_VOICE_MODEL=aisurplus:deepseek-v4-flash    # the journal's writer
# WH_ADVISOR_MODEL=aisurplus:deepseek-v4-flash  # the advisor's writer (defaults to the journal's)
# WH_AISURPLUS_FALLBACK=gpt-5.6-luna            # paid model used when the free lane's shared weekly quota is out
# The fee policy: of every claim, forwarded to the creator, spent buying $WORM and sending it to the burn
# address, and the rest kept for compute, gas and the reserve. Trading stays off until the creator turns it on.
# WH_OWNER_SHARE=0.50
# WH_GOLD_SHARE=0.10
# WH_BURN_SHARE=0.20
# WH_TRADING=0
# Rehearsal knobs (defaults shown): the treasury's minimums, so a throwaway token with a few dollars of fees exercises every step
# At >=90 days of funded USDG operating costs, claims switch to a 24-hour minimum interval.
# WH_CLAIM_MIN_USD=5
# WH_CLAIM_MAX_USD=100
# WH_CLAIM_BATCH_HOURS=6
# WH_CLAIM_MAX_WAIT_HOURS=24
# WH_CLAIM_DUST_USD=1
# WH_CLAIM_MAX_GAS_FRACTION=0.02
# WH_CLAIM_ETH_RESERVE=0.0001
# WH_MIN_BURN_USD=5.0
# WH_MIN_GOLD_USD=5.0
# Audit-era knobs (defaults shown): compute top-up guard rails, lab thresholds, readiness gate
# WH_TOPUP_COOLDOWN_S=21600   # at most one compute top-up per 6 hours
# WH_TOPUP_MAX_PER_DAY=2
# WH_TOPUP_ALWAYS=0           # 1: top up even when no writer runs at the provider, or its models are free
# WH_LAB_MIN_N=30             # cases an exit rule needs before it can win
# WH_LAB_LCB_Z=1.5            # lower-confidence-bound factor for ranking arms
# WH_LAB_EXPLORE=0            # share of positions that try a non-winning arm
# WH_READY_AT=80              # readiness needed before real trades

# Payment recovery (review docs/PAYMENT-RECOVERY.md before deployment)
# WH_OPS_TOKEN=                 # required for launch control, including localhost; keep private
# WH_SCREEN_CDP_URL=            # private isolated browser CDP endpoint; required for a live screen
# Proceed on verified block inclusion (default); optional stronger mode: finalized.
# Included receipts remain monitored for chain changes. This is not finality.
# WH_TX_CONFIRMATION=included
# WH_MAX_TX_FEE_ETH=0.002
# WH_MAX_DAILY_FEE_ETH=0.01
# WH_MAX_TX_VALUE_ETH=0.01
# WH_TOPUP_MAX_USD=5
# WH_TOPUP_MAX_DAILY_USD=10
# WH_VENICE_PAY_TO=             # independently verified Venice recipient; required for live x402
# Existing unallocated claims require explicit historical policy; do not guess these values:
# WH_LEGACY_OWNER_SHARE=
# WH_LEGACY_BURN_SHARE=
# WH_LEGACY_GOLD_SHARE=
# WH_LAUNCH_AT=                # future ISO 8601 timestamp with timezone; initializes an absent schedule only

# Operations-only native ETH refill. Start disabled; arm only after a bounded rehearsal.
WH_GAS_REFILL=0
WH_GAS_REFILL_BELOW_ETH=0.0003
WH_GAS_REFILL_TARGET_ETH=0.0015
WH_GAS_REFILL_MAX_USD=5
WH_GAS_REFILL_DAILY_USD=10
WH_GAS_REFILL_COOLDOWN_HOURS=6
WH_GAS_REFILL_KEEP_USDG=1
WH_GAS_REFILL_MAX_FEE_FRACTION=0.05
# Protected by every Robinhood Chain transaction while automatic refill is enabled.
WH_GAS_BOOTSTRAP_ETH=0.00005

# Separate read-only monitor credential; never share WH_OPS_TOKEN with monitoring services.
# GET /api/ops/health with X-Health-Token returns 503 for an operational alert.
WH_HEALTH_TOKEN=
